# P13 — Facturación electrónica ARCA (backend).
# `.env` está gitignoreado: acá van SOLO los nombres, sin valores reales.
# El CUIT y el punto de venta NO son secretos: viven en la tabla
# `invoicing_settings` (se cargan por la API de settings del emisor).

# Ambiente ARCA: "homo" (default) o "prod". Con ENVIRONMENT=prod es
# obligatorio AFIP_ENV=prod (el arranque falla si apunta a homologación).
AFIP_ENV=

# Credenciales del certificado de facturación: paths montados...
AFIP_PRIVATE_KEY_PATH=
AFIP_CERT_PATH=
# ...o el contenido PEM (o base64 de ese PEM) directo en el entorno.
AFIP_PRIVATE_KEY_PEM=
AFIP_CERT_PEM=

# Overrides opcionales de los endpoints (vacíos = tabla por ambiente).
AFIP_WSAA_URL=
AFIP_WSFE_URL=
