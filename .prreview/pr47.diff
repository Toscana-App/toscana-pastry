+        justifyContent="center"
+        pt="10"
+        px="4"
+        pb="8"
+      >
+        <Stack width="full" maxW="container.sm" gap="4">
+          <Skeleton h="10" w="45%" alignSelf="center" />
+          <Skeleton h="12" w="100%" borderRadius="xl" />
+          <Skeleton h="12" w="100%" borderRadius="xl" />
+          <Skeleton h="12" w="100%" borderRadius="xl" />
+        </Stack>
+      </Box>
+    </Flex>
